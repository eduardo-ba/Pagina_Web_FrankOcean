---
import ArchiveLogo from "./ArchiveLogo.astro";
import { translations } from "../data/i18n";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const links = [
  { href: "/", index: "01", key: "nav.cover", matches: ["/"] },
  {
    href: "/discografia",
    index: "02",
    key: "nav.archive",
    matches: ["/discografia", "/archivo"],
  },
  {
    href: "/biografia",
    index: "03",
    key: "nav.history",
    matches: ["/biografia"],
  },
  {
    href: "/explorar",
    index: "04",
    key: "nav.explore",
    matches: ["/explorar", "/radio", "/objetos", "/ediciones"],
  },
  {
    href: "/contacto",
    index: "05",
    key: "nav.credits",
    matches: ["/contacto"],
  },
];
const isCurrent = (matches: string[]) =>
  matches.some((path) =>
    path === "/" ? currentPath === path : currentPath.startsWith(path),
  );
---

<header class="archive-header">
  <a
    class="archive-brand"
    href="/"
    aria-label={translations.es["global.brandHome"]}
    data-i18n-aria-label="global.brandHome"
  >
    <ArchiveLogo />
  </a>

  <nav
    aria-label={translations.es["global.navAria"]}
    data-i18n-aria-label="global.navAria"
  >
    <ul class="archive-nav">
      {
        links.map(({ href, index, key, matches }) => (
          <li>
            <a
              href={href}
              aria-current={isCurrent(matches) ? "page" : undefined}
            >
              <span>{index} /</span>{" "}
              <span data-i18n={key}>{translations.es[key]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div
    class="brand-language"
    role="group"
    aria-label={translations.es["global.languageAria"]}
    data-i18n-aria-label="global.languageAria"
  >
    <button type="button" data-language="es" aria-pressed="true">ES</button>
    <button type="button" data-language="en" aria-pressed="false">EN</button>
  </div>
</header>
