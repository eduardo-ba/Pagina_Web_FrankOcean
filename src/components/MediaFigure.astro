---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { translations } from "../data/i18n";

interface Props {
  src: ImageMetadata;
  altKey: string;
  captionKey?: string;
  class?: string;
  eager?: boolean;
  sizes?: string;
}

const {
  src,
  altKey,
  captionKey,
  class: className,
  eager = false,
  sizes = "(min-width: 900px) 55vw, 100vw",
} = Astro.props;
---

<figure class:list={["media-figure", className]}>
  <Image
    src={src}
    alt={translations.es[altKey]}
    data-i18n-alt={altKey}
    widths={[480, 768, 1080, 1600]}
    sizes={sizes}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    decoding="async"
  />
  {
    captionKey && (
      <figcaption data-i18n={captionKey}>
        {translations.es[captionKey]}
      </figcaption>
    )
  }
</figure>
