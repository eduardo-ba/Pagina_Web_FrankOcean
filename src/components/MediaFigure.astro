---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  class?: string;
  eager?: boolean;
  sizes?: string;
}

const {
  src,
  alt,
  caption,
  class: className,
  eager = false,
  sizes = "(min-width: 900px) 55vw, 100vw",
} = Astro.props;
---

<figure class:list={["media-figure", className]}>
  <Image
    src={src}
    alt={alt}
    widths={[480, 768, 1080, 1600]}
    sizes={sizes}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
