---
import MediaFigure from "../components/MediaFigure.astro";
import { archiveEras, archiveMedia } from "../data/albums";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Portada"
  description="Blonded Visual Archive: colección personal, no oficial y no comercial sobre la obra y las eras de Frank Ocean."
  pageTheme="black"
>
  <section class="archive-gate">
    <MediaFigure
      src={archiveMedia.collage}
      alt="Collage editorial inspirado en la era Blonde"
      class="archive-gate__image"
      eager
      sizes="100vw"
    />
    <div class="archive-gate__wash" aria-hidden="true"></div>
    <p class="archive-gate__meta">
      Unofficial personal archive<br />2011—present / ES
    </p>
    <h1><span>Blonded</span><span>Visual Archive</span></h1>
    <p class="archive-gate__edition">
      Edición 01<br />Memoria / sonido / imagen
    </p>
    <a class="archive-gate__scroll" href="#manifiesto"
      >Abrir archivo <span aria-hidden="true">↓</span></a
    >
  </section>

  <section id="manifiesto" class="archive-statement reveal">
    <div class="archive-statement__meta">
      <span>Nota del editor / 001</span>
      <span>Luis Eduardo Barrón Álvarez</span>
    </div>
    <blockquote>
      Un registro de las canciones que dieron forma al tiempo, y de los
      recuerdos que ahora viven dentro de ellas.
    </blockquote>
    <p>
      Blonded Visual Archive reúne obras, imágenes y transmisiones desde una
      mirada personal. No es una cronología definitiva: es una colección en
      proceso.
    </p>
  </section>

  <section class="era-index" aria-labelledby="era-index-title">
    <header class="era-index__header">
      <p class="archive-label">Índice cromático / cinco registros</p>
      <h2 id="era-index-title">Eras en archivo</h2>
    </header>
    <ol>
      {
        archiveEras.map((era, index) => (
          <li data-era={era.theme} class="reveal">
            <a href={`/discografia#${era.slug}`}>
              <span class="era-index__number">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="era-index__name">{era.title}</span>
              <span class="era-index__year">{era.year}</span>
              <span class="era-index__arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="transmission reveal" aria-labelledby="transmission-title">
    <div class="transmission__copy">
      <p class="archive-label">Selected transmission / 09:53</p>
      <h2 id="transmission-title">Pyramids</h2>
      <p>
        Del mito a Las Vegas en dos movimientos. Una pieza donde producción,
        personaje y tiempo cambian de forma sin romper la narración.
      </p>
      <a
        class="archive-link archive-link--light"
        href="https://www.youtube.com/watch?v=dMV31MWIjLE"
        target="_blank"
        rel="noopener noreferrer"
      >
        Ver transmisión <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="transmission__frame">
      <iframe
        src="https://www.youtube-nocookie.com/embed/dMV31MWIjLE"
        title="Frank Ocean — Pyramids, video musical"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen></iframe>
    </div>
    <p class="transmission__caption">
      Channel Orange / 2012 / Def Jam Recordings
    </p>
  </section>
</BaseLayout>
