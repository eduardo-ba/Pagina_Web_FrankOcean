---
import MediaFigure from "../components/MediaFigure.astro";
import { archiveEras, archiveMedia } from "../data/albums";
import { translations } from "../data/i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout metaKey="home" pageTheme="black">
  <section class="archive-gate">
    <div class="archive-gate__media">
      <MediaFigure
        src={archiveMedia.portrait}
        altKey="home.heroPortraitAlt"
        class="archive-gate__image archive-gate__image--portrait"
        eager
        sizes="100vw"
      />
      <MediaFigure
        src={archiveEras[0].cover}
        altKey="era.nostalgia-ultra.alt"
        class="archive-gate__image archive-gate__image--artifact-one"
        sizes="(min-width: 900px) 18vw, 42vw"
      />
      <MediaFigure
        src={archiveEras[3].cover}
        altKey="era.blonde.alt"
        class="archive-gate__image archive-gate__image--artifact-two"
        sizes="(min-width: 900px) 15vw, 34vw"
      />
    </div>
    <div class="archive-gate__wash" aria-hidden="true"></div>
    <p class="archive-gate__meta">
      <span data-i18n="home.heroMeta">{translations.es["home.heroMeta"]}</span
      ><br />
      <span data-i18n="home.heroPresent"
        >{translations.es["home.heroPresent"]}</span
      >
    </p>
    <h1>
      <span data-i18n="brand.primary">{translations.es["brand.primary"]}</span>
      <span data-i18n="brand.secondary"
        >{translations.es["brand.secondary"]}</span
      >
    </h1>
    <p class="archive-gate__edition">
      <span data-i18n="home.edition">{translations.es["home.edition"]}</span><br
      />
      <span data-i18n="home.editionTopics"
        >{translations.es["home.editionTopics"]}</span
      >
    </p>
    <a class="archive-gate__scroll" href="#manifiesto">
      <span data-i18n="home.open">{translations.es["home.open"]}</span>
      <span aria-hidden="true">↓</span>
    </a>
  </section>

  <section id="manifiesto" class="archive-statement reveal">
    <div class="archive-statement__meta">
      <span data-i18n="home.editorNote"
        >{translations.es["home.editorNote"]}</span
      >
      <span data-i18n="home.archiveSignature"
        >{translations.es["home.archiveSignature"]}</span
      >
    </div>
    <blockquote data-i18n="home.manifestoQuote">
      {translations.es["home.manifestoQuote"]}
    </blockquote>
    <p data-i18n="home.manifestoBody">
      {translations.es["home.manifestoBody"]}
    </p>
  </section>

  <section class="era-index" aria-labelledby="era-index-title">
    <header class="era-index__header">
      <p class="archive-label" data-i18n="home.eraLabel">
        {translations.es["home.eraLabel"]}
      </p>
      <h2 id="era-index-title" data-i18n="home.eraTitle">
        {translations.es["home.eraTitle"]}
      </h2>
    </header>
    <ol>
      {
        archiveEras.map((era, index) => {
          const titleKey = `era.${era.slug}.title`;
          return (
            <li data-era={era.theme} class="reveal">
              <a href={`/discografia#${era.slug}`}>
                <span class="era-index__number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="era-index__name" data-i18n={titleKey}>
                  {translations.es[titleKey]}
                </span>
                <span class="era-index__year">{era.year}</span>
                <span class="era-index__arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>

  <section class="transmission reveal" aria-labelledby="transmission-title">
    <div class="transmission__copy">
      <p class="archive-label" data-i18n="home.transmissionLabel">
        {translations.es["home.transmissionLabel"]}
      </p>
      <h2 id="transmission-title">Pyramids</h2>
      <p data-i18n="home.transmissionBody">
        {translations.es["home.transmissionBody"]}
      </p>
      <a
        class="archive-link archive-link--light"
        href="https://www.youtube.com/watch?v=dMV31MWIjLE"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span data-i18n="home.transmissionLink">
          {translations.es["home.transmissionLink"]}
        </span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="transmission__frame">
      <iframe
        src="https://www.youtube-nocookie.com/embed/dMV31MWIjLE"
        title={translations.es["home.iframeTitle"]}
        data-i18n-title="home.iframeTitle"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen></iframe>
    </div>
    <p class="transmission__caption" data-i18n="home.transmissionCaption">
      {translations.es["home.transmissionCaption"]}
    </p>
  </section>
</BaseLayout>
