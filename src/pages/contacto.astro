---
import EditorialIntro from "../components/EditorialIntro.astro";
import { translations } from "../data/i18n";
import BaseLayout from "../layouts/BaseLayout.astro";

const year = new Date().getFullYear();
---

<BaseLayout metaKey="credits" pageTheme="black">
  <EditorialIntro
    indexKey="credits.introIndex"
    eyebrowKey="credits.introEyebrow"
    titleKey="credits.introTitle"
    descriptionKey="credits.introDescription"
    variant="dark"
  />

  <section class="credits-ledger">
    <article class="credits-author reveal">
      <p class="archive-label" data-i18n="credits.authorLabel">
        {translations.es["credits.authorLabel"]}
      </p>
      <h2 data-i18n="credits.authorTitle">
        {translations.es["credits.authorTitle"]}
      </h2>
      <p class="credits-author__statement" data-i18n="credits.authorBody">
        {translations.es["credits.authorBody"]}
      </p>
      <p class="credits-author__byline">
        <span data-i18n="credits.byline"
          >{translations.es["credits.byline"]}</span
        >
        / Luis Eduardo Barrón Álvarez
      </p>
    </article>

    <div
      class="credits-index"
      aria-label={translations.es["credits.linksAria"]}
      data-i18n-aria-label="credits.linksAria"
    >
      <a
        href="https://github.com/eduardo-ba"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span data-i18n="credits.codeLabel"
          >{translations.es["credits.codeLabel"]}</span
        >
        <strong>GitHub</strong><span aria-hidden="true">↗</span>
      </a>
      <a
        href="https://open.spotify.com/playlist/2iDpx90bonkWEaOvkVFpCl"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span data-i18n="credits.listeningLabel">
          {translations.es["credits.listeningLabel"]}
        </span>
        <strong>Playlist</strong><span aria-hidden="true">↗</span>
      </a>
      <a href="/discografia">
        <span data-i18n="credits.returnLabel"
          >{translations.es["credits.returnLabel"]}</span
        >
        <strong data-i18n="credits.archive"
          >{translations.es["credits.archive"]}</strong
        >
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="archive-notes reveal">
    <div>
      <p class="archive-label" data-i18n="credits.systemLabel">
        {translations.es["credits.systemLabel"]}
      </p>
      <p data-i18n="credits.systemBody">
        {translations.es["credits.systemBody"]}
      </p>
    </div>
    <div>
      <p class="archive-label" data-i18n="credits.characterLabel">
        {translations.es["credits.characterLabel"]}
      </p>
      <p data-i18n="credits.characterBody">
        {translations.es["credits.characterBody"]}
      </p>
    </div>
    <div>
      <p class="archive-label" data-i18n="credits.rightsLabel">
        {translations.es["credits.rightsLabel"]}
      </p>
      <p data-i18n="credits.rightsBody">
        {translations.es["credits.rightsBody"]}
      </p>
    </div>
    <div>
      <p class="archive-label" data-i18n="credits.editionLabel">
        {translations.es["credits.editionLabel"]}
      </p>
      <p>
        <span data-i18n="credits.location"
          >{translations.es["credits.location"]}</span
        > / {year}
      </p>
    </div>
  </section>
</BaseLayout>
