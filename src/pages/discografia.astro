---
import EditorialIntro from "../components/EditorialIntro.astro";
import EraChapter from "../components/EraChapter.astro";
import { archiveEras } from "../data/albums";
import { translations } from "../data/i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout metaKey="archive">
  <EditorialIntro
    indexKey="archive.introIndex"
    eyebrowKey="archive.introEyebrow"
    titleKey="archive.introTitle"
    descriptionKey="archive.introDescription"
  />

  <nav
    class="chapter-nav"
    aria-label={translations.es["archive.chapterNavAria"]}
    data-i18n-aria-label="archive.chapterNavAria"
  >
    {
      archiveEras.map((era, index) => {
        const titleKey = `era.${era.slug}.title`;
        return (
          <a href={`#${era.slug}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>{" "}
            <span data-i18n={titleKey}>{translations.es[titleKey]}</span>
          </a>
        );
      })
    }
  </nav>

  <section
    class="era-sequence"
    aria-label={translations.es["archive.sequenceAria"]}
    data-i18n-aria-label="archive.sequenceAria"
  >
    {archiveEras.map((era, index) => <EraChapter era={era} index={index} />)}
  </section>

  <aside class="asset-note">
    <p class="archive-label" data-i18n="archive.assetLabel">
      {translations.es["archive.assetLabel"]}
    </p>
    <p data-i18n="archive.assetBody">{translations.es["archive.assetBody"]}</p>
  </aside>
</BaseLayout>
