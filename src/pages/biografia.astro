---
import { Image } from "astro:assets";
import EditorialIntro from "../components/EditorialIntro.astro";
import MediaFigure from "../components/MediaFigure.astro";
import { archiveMedia, archiveYears } from "../data/albums";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Historia"
  description="Una secuencia editorial por momentos decisivos en la trayectoria creativa de Frank Ocean."
>
  <EditorialIntro
    index="03 / Historia oral"
    eyebrow="Christopher Francis Ocean"
    title="A voice outside time."
    description="No una biografía exhaustiva, sino cinco cortes: lugares, obras y decisiones que cambiaron la escala de una voz."
  />

  <section class="portrait-spread reveal" aria-label="Retrato de apertura">
    <Image
      src={archiveMedia.portrait}
      alt="Retrato de Frank Ocean sobre fondo azul"
      widths={[474, 768, 960]}
      sizes="(min-width: 900px) 42vw, 84vw"
      loading="eager"
      fetchpriority="high"
    />
    <p class="portrait-spread__name">Frank<br />Ocean</p>
    <p class="portrait-spread__roles">
      Cantante / compositor / productor<br />Nueva Orleans → Los Ángeles
    </p>
  </section>

  <nav class="year-index" aria-label="Índice de años">
    {
      archiveYears.map((entry) => (
        <a href={`#year-${entry.years.slice(0, 4)}`}>{entry.years}</a>
      ))
    }
  </nav>

  <section class="history-sequence" aria-label="Momentos en la trayectoria">
    {
      archiveYears.map((entry, index) => (
        <article
          id={`year-${entry.years.slice(0, 4)}`}
          class:list={[
            "history-entry",
            index === 4 && "history-entry--climax",
            "reveal",
          ]}
        >
          <div class="history-entry__year" aria-hidden="true">
            {entry.years}
          </div>
          <p class="archive-label">
            Corte {String(index + 1).padStart(2, "0")}
          </p>
          <h2>{entry.title}</h2>
          <p class="history-entry__copy">{entry.text}</p>
          {index === 2 && (
            <MediaFigure
              src={archiveMedia.playlist}
              alt="Arte de una selección personal de canciones"
              caption="Selección personal / registro de escucha"
              class="history-entry__media history-entry__media--small"
              sizes="(min-width: 900px) 28vw, 72vw"
            />
          )}
          {index === 4 && (
            <MediaFigure
              src={archiveMedia.collage}
              alt="Collage editorial asociado a Blonde"
              caption="2016 / Endless + Blonde"
              class="history-entry__media"
              sizes="(min-width: 900px) 45vw, 100vw"
            />
          )}
        </article>
      ))
    }
  </section>

  <section class="history-close reveal">
    <p class="archive-label">Cierre abierto</p>
    <p>
      La independencia no aparece aquí como punto final, sino como método:
      publicar menos, decidir más y dejar espacio para que cada obra cambie con
      quien la escucha.
    </p>
  </section>
</BaseLayout>
