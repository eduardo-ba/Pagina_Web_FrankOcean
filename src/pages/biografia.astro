---
import { Image } from "astro:assets";
import EditorialIntro from "../components/EditorialIntro.astro";
import MediaFigure from "../components/MediaFigure.astro";
import { archiveMedia, archiveYears } from "../data/albums";
import { translations } from "../data/i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout metaKey="history">
  <EditorialIntro
    indexKey="history.introIndex"
    eyebrowKey="history.introEyebrow"
    titleKey="history.introTitle"
    descriptionKey="history.introDescription"
  />

  <section
    class="portrait-spread reveal"
    aria-label={translations.es["history.portraitAria"]}
    data-i18n-aria-label="history.portraitAria"
  >
    <Image
      src={archiveMedia.portrait}
      alt={translations.es["history.portraitAlt"]}
      data-i18n-alt="history.portraitAlt"
      widths={[474, 768, 960]}
      sizes="(min-width: 900px) 42vw, 84vw"
      loading="eager"
      fetchpriority="high"
    />
    <p class="portrait-spread__name">Frank<br />Ocean</p>
    <p class="portrait-spread__roles">
      <span data-i18n="history.roles">{translations.es["history.roles"]}</span
      ><br />
      <span data-i18n="history.route">{translations.es["history.route"]}</span>
    </p>
  </section>

  <nav
    class="year-index"
    aria-label={translations.es["history.yearIndexAria"]}
    data-i18n-aria-label="history.yearIndexAria"
  >
    {
      archiveYears.map((years) => (
        <a href={`#year-${years.slice(0, 4)}`}>{years}</a>
      ))
    }
  </nav>

  <section
    class="history-sequence"
    aria-label={translations.es["history.sequenceAria"]}
    data-i18n-aria-label="history.sequenceAria"
  >
    {
      archiveYears.map((years, index) => {
        const yearKey = years.slice(0, 4);
        const titleKey = `history.year.${yearKey}.title`;
        const textKey = `history.year.${yearKey}.text`;
        return (
          <article
            id={`year-${yearKey}`}
            class:list={[
              "history-entry",
              index === 4 && "history-entry--climax",
              "reveal",
            ]}
          >
            <div class="history-entry__year" aria-hidden="true">
              {years}
            </div>
            <p class="archive-label">
              <span data-i18n="history.cut">
                {translations.es["history.cut"]}
              </span>{" "}
              {String(index + 1).padStart(2, "0")}
            </p>
            <h2 data-i18n={titleKey}>{translations.es[titleKey]}</h2>
            <p class="history-entry__copy" data-i18n={textKey}>
              {translations.es[textKey]}
            </p>
            {index === 2 && (
              <MediaFigure
                src={archiveMedia.playlist}
                altKey="history.playlistAlt"
                captionKey="history.playlistCaption"
                class="history-entry__media history-entry__media--small"
                sizes="(min-width: 900px) 28vw, 72vw"
              />
            )}
            {index === 4 && (
              <MediaFigure
                src={archiveMedia.collage}
                altKey="history.collageAlt"
                captionKey="history.collageCaption"
                class="history-entry__media"
                sizes="(min-width: 900px) 45vw, 100vw"
              />
            )}
          </article>
        );
      })
    }
  </section>

  <section class="history-close reveal">
    <p class="archive-label" data-i18n="history.closeLabel">
      {translations.es["history.closeLabel"]}
    </p>
    <p data-i18n="history.closeBody">{translations.es["history.closeBody"]}</p>
  </section>
</BaseLayout>
