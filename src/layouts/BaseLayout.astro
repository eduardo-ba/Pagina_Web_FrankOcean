---
import ArchiveFooter from "../components/ArchiveFooter.astro";
import ArchiveHeader from "../components/ArchiveHeader.astro";
import { translations } from "../data/i18n";
import "../styles/global.css";

interface Props {
  metaKey:
    | "home"
    | "archive"
    | "history"
    | "credits"
    | "radio"
    | "explore"
    | "objects"
    | "editions"
    | "era-nostalgia-ultra"
    | "era-channel-orange"
    | "era-endless"
    | "era-blonde"
    | "era-singles";
  pageTheme?: "paper" | "black";
  socialImage?: string;
}

const {
  metaKey,
  pageTheme = "paper",
  socialImage = "/social/blonded-visual-archive-og.jpg",
} = Astro.props;
const titleKey = `meta.${metaKey}.title`;
const descriptionKey = `meta.${metaKey}.description`;
const currentPath = Astro.url.pathname;
const siteOrigin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(currentPath, siteOrigin);
const socialImageUrl = new URL(socialImage, siteOrigin);
---

<!doctype html>
<html lang="es" data-page-theme={pageTheme} data-language="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={translations.es[descriptionKey]} />
    <meta
      name="theme-color"
      content={pageTheme === "black" ? "#090908" : "#f0eddf"}
    />
    <meta property="og:title" content={translations.es[titleKey]} />
    <meta property="og:description" content={translations.es[descriptionKey]} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Blonded Visual Archive" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={translations.es["meta.socialImageAlt"]}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={translations.es[titleKey]} />
    <meta
      name="twitter:description"
      content={translations.es[descriptionKey]}
    />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta
      name="twitter:image:alt"
      content={translations.es["meta.socialImageAlt"]}
    />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ediciones — Archivo Visual Blonded"
      href="/ediciones.xml"
    />
    <link rel="icon" href="/brand/bva-mark.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/bva-mark-32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/bva-touch-icon.png" />
    <link rel="mask-icon" href="/brand/bva-mask.svg" color="#b7f34a" />
    <script is:inline>
      try {
        const storedLanguage =
          localStorage.getItem("bva-language") ??
          localStorage.getItem("bva-brand-language");
        document.documentElement.dataset.language =
          storedLanguage === "en" ? "en" : "es";
        document.documentElement.lang = storedLanguage === "en" ? "en" : "es";
      } catch {
        document.documentElement.dataset.language = "es";
      }
    </script>
    <title>{translations.es[titleKey]}</title>
  </head>
  <body
    id="inicio"
    data-title-key={titleKey}
    data-description-key={descriptionKey}
  >
    <a class="skip-link" href="#contenido" data-i18n="global.skip"
      >{translations.es["global.skip"]}</a
    >
    <ArchiveHeader currentPath={currentPath} />
    <main id="contenido">
      <slot />
    </main>
    <ArchiveFooter />
    <script>
      import { translations, type Language } from "../data/i18n";

      const applyLanguage = (language: Language) => {
        const copy = translations[language];
        document.documentElement.dataset.language = language;
        document.documentElement.lang = language;

        document
          .querySelectorAll<HTMLElement>("[data-i18n]")
          .forEach((element) => {
            const key = element.dataset.i18n;
            if (key && copy[key]) element.textContent = copy[key];
          });

        document
          .querySelectorAll<HTMLElement>("[data-copy-es][data-copy-en]")
          .forEach((element) => {
            const value =
              language === "en"
                ? element.dataset.copyEn
                : element.dataset.copyEs;
            if (value) element.textContent = value;
          });

        document
          .querySelectorAll<HTMLElement>("[data-copy-alt-es][data-copy-alt-en]")
          .forEach((element) => {
            const value =
              language === "en"
                ? element.dataset.copyAltEn
                : element.dataset.copyAltEs;
            if (value) element.setAttribute("alt", value);
          });

        const translatedAttributes = [
          ["data-i18n-alt", "alt"],
          ["data-i18n-aria-label", "aria-label"],
          ["data-i18n-title", "title"],
          ["data-i18n-placeholder", "placeholder"],
        ] as const;

        translatedAttributes.forEach(([keyAttribute, targetAttribute]) => {
          document
            .querySelectorAll<HTMLElement>(`[${keyAttribute}]`)
            .forEach((element) => {
              const key = element.getAttribute(keyAttribute);
              if (key && copy[key])
                element.setAttribute(targetAttribute, copy[key]);
            });
        });

        document
          .querySelectorAll<HTMLButtonElement>("[data-language]")
          .forEach((button) => {
            button.setAttribute(
              "aria-pressed",
              String(button.dataset.language === language),
            );
          });

        const titleKey = document.body.dataset.titleKey;
        const descriptionKey = document.body.dataset.descriptionKey;
        if (titleKey && copy[titleKey]) {
          document.title = copy[titleKey];
          document
            .querySelector<HTMLMetaElement>('meta[property="og:title"]')
            ?.setAttribute("content", copy[titleKey]);
          document
            .querySelector<HTMLMetaElement>('meta[name="twitter:title"]')
            ?.setAttribute("content", copy[titleKey]);
        }
        if (descriptionKey && copy[descriptionKey]) {
          document
            .querySelector<HTMLMetaElement>('meta[name="description"]')
            ?.setAttribute("content", copy[descriptionKey]);
          document
            .querySelector<HTMLMetaElement>('meta[property="og:description"]')
            ?.setAttribute("content", copy[descriptionKey]);
          document
            .querySelector<HTMLMetaElement>('meta[name="twitter:description"]')
            ?.setAttribute("content", copy[descriptionKey]);
        }

        const socialImageAlt = copy["meta.socialImageAlt"];
        if (socialImageAlt) {
          document
            .querySelector<HTMLMetaElement>('meta[property="og:image:alt"]')
            ?.setAttribute("content", socialImageAlt);
          document
            .querySelector<HTMLMetaElement>('meta[name="twitter:image:alt"]')
            ?.setAttribute("content", socialImageAlt);
        }

        document
          .querySelector<HTMLMetaElement>('meta[property="og:locale"]')
          ?.setAttribute("content", language === "en" ? "en_US" : "es_MX");

        window.dispatchEvent(
          new CustomEvent("bva:languagechange", { detail: { language } }),
        );
      };

      const initialLanguage: Language =
        document.documentElement.dataset.language === "en" ? "en" : "es";
      applyLanguage(initialLanguage);

      document
        .querySelectorAll<HTMLButtonElement>("[data-language]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const language: Language =
              button.dataset.language === "en" ? "en" : "es";
            applyLanguage(language);
            try {
              localStorage.setItem("bva-language", language);
            } catch {
              // La selección sigue activa durante la visita actual.
            }
          });
        });

      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const reveals = document.querySelectorAll<HTMLElement>(".reveal");

      if (reducedMotion || !("IntersectionObserver" in window)) {
        reveals.forEach((item) => item.classList.add("is-visible"));
      } else {
        document.documentElement.classList.add("has-reveal");
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8%", threshold: 0.12 },
        );
        reveals.forEach((item) => observer.observe(item));
      }
    </script>
  </body>
</html>
